# Copy this file to .env (chmod 600) and adapt it before the first start. See README, "Getting started".

# --- Access -----------------------------------------------------------------------------------------------
# Address typed by the users: OpenID Connect callback, API docs, URLs shown, Secure cookies when https,
# domain of the security keys (WebAuthn)
REFEX_PUBLIC_URL=http://localhost:8080
# Published port of the interface. Behind a reverse proxy on the same host: 127.0.0.1:8080
FRONTEND_PORT=8080

# --- Secrets (used at the first start: set them before) ---------------------------------------------------
# Database password (letters and digits: openssl rand -hex 24)
POSTGRES_PASSWORD=refexposer
# Encryption key of the stored secrets, confidential referentials and configuration backups.
# At least 32 characters: openssl rand -base64 48. Keep a copy outside the server.
# Empty: generated in data/.secret_key (fine for a test only)
# REFEX_SECRET_KEY=

# Initial administrator (created when no administrator exists; the password must be changed at first sign-in)
REFEX_ADMIN_USERNAME=admin
REFEX_ADMIN_PASSWORD=ChangeMe-Now-2026!
# REFEX_ADMIN_EMAIL=admin@example.com
# REFEX_ADMIN_RESET_PASSWORD=true   # recovery: resets this account at startup, then set it back to false

# --- Authentication ---------------------------------------------------------------------------------------
# false = no username / password sign-in for local accounts in the interface (single sign-on only), once
# OpenID Connect or LDAP is configured and an administrator can sign in with it. API tokens are not affected.
REFEX_LOCAL_LOGIN=true
REFEX_SESSION_TTL_HOURS=12
# Secure cookies are automatic when REFEX_PUBLIC_URL is https
REFEX_COOKIE_SECURE=false
# REFEX_PASSWORD_MIN_LENGTH=12
# REFEX_API_TOKEN_MAX_DAYS=365

# --- Containers -------------------------------------------------------------------------------------------
# Account running the backend (set at build time). ./data and ./import are given to it at every start
# (init-permissions service); use your own ids to read these folders without sudo: id -u / id -g
# REFEX_UID=10001
# REFEX_GID=10001

# --- Updates and logs -------------------------------------------------------------------------------------
REFEX_LOG_LEVEL=info                # trace, debug, info, warning, error or critical
REFEX_REFRESH_ON_STARTUP=missing    # missing, all or none
REFEX_SCHEDULER_ENABLED=true
REFEX_TIMEZONE=Europe/Paris
REFEX_MAX_CONCURRENT_JOBS=2
REFEX_HTTP_VERIFY=true              # true, false, or path of a CA bundle
# REFEX_DUCKDB_MEMORY_LIMIT=4GB
# REFEX_SQL_TIMEOUT=30
# REFEX_INTERNAL_PUBLISH_DELAY=2    # internal referentials: seconds without edits before publishing

# --- Source credentials -----------------------------------------------------------------------------------
# ${REFEX_SOURCE_...} variables can be used in the source headers, basic_auth and Git token of the definitions
# (only this prefix is expanded), so that keys stay out of the definitions
# REFEX_SOURCE_MAXMIND_ACCOUNT=123456
# REFEX_SOURCE_MAXMIND_KEY=
# REFEX_SOURCE_GIT_TOKEN=
# Git sources: allowed transports (https,http for an internal server without TLS), time limit of a fetch
# REFEX_GIT_PROTOCOLS=https
# REFEX_GIT_TIMEOUT=900

# --- Large referentials -----------------------------------------------------------------------------------
# REFEX_LARGE_ROWS=50000000         # guardrails above this row count
# REFEX_FACETS_MAX_ROWS=20000000    # search facets disabled above (default: REFEX_LARGE_ROWS)
# REFEX_QUERY_TIMEOUT=60

# --- Folders ----------------------------------------------------------------------------------------------
# Sync folder (./sync): every file or folder pushed there is a referential
# REFEX_SYNC_POLL_SECONDS=60
# REFEX_SYNC_SETTLE_SECONDS=30
# Import folder (./import): files dropped in import/<referential id>/ become a new version
# REFEX_IMPORT_POLL_SECONDS=20

# --- Company proxy (downloads and image build; can also be set in Administration › Settings) ---------------
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1,backend,frontend
