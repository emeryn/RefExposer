# Where the build takes its base images and its packages.
#
# Copy to .env.build, fill in your repository addresses, then:
#   docker compose --env-file .env.build build --pull
#
# Every variable has a public default: leave one empty (or remove the line) and the build uses the public
# source for it. See enterprise/README.md. Nothing here is a secret — credentials belong in `docker login`,
# in ~/.npmrc or in a token your CI injects, never in this file.

# --- Base images ------------------------------------------------------------------------------------------
# Your Docker Hub proxy, or the images you mirrored with enterprise/mirror-images.sh
PYTHON_IMAGE=registry.example.com/refexposer/python:3.12-slim
NODE_IMAGE=registry.example.com/refexposer/node:22-alpine
NGINX_IMAGE=registry.example.com/refexposer/nginxinc/nginx-unprivileged:1.31-alpine-slim
# Runtime, not build: set it in the environment you deploy with as well
POSTGRES_IMAGE=registry.example.com/refexposer/postgres:17-alpine

# --- Python -----------------------------------------------------------------------------------------------
# The index must serve the exact files pinned in backend/requirements.txt (versions and hashes): a proxy of
# PyPI does, a curated index may not. See README section 7.
PIP_INDEX_URL=https://nexus.example.com/repository/pypi-proxy/simple
# Anything else pip needs. Prefer --cert over --trusted-host: it points the check at the right authority
# instead of turning it off.
# PIP_EXTRA_ARGS=--cert /etc/ssl/certs/company-root-ca.crt
PIP_EXTRA_ARGS=

# --- Frontend ---------------------------------------------------------------------------------------------
NPM_REGISTRY=https://nexus.example.com/repository/npm-proxy/
# NPM_EXTRA_ARGS=--ca-file /etc/ssl/certs/company-root-ca.crt
NPM_EXTRA_ARGS=

# --- Security updates of the base images ------------------------------------------------------------------
# Mirror roots: the Debian one replaces deb.debian.org and security.debian.org, the Alpine one must hold
# v3.24/main. Empty: the public mirrors (the build then needs to reach them).
APT_MIRROR=https://mirror.example.com/debian
APK_MIRROR=https://mirror.example.com/alpine
# 0: skip the apt / apk step altogether, because the base images above already carry the security updates
# AND git. Required when no mirror is reachable at all. See README section 6.
# OS_UPDATE=0

# --- DuckDB extensions ------------------------------------------------------------------------------------
# The backend pre-installs excel, httpfs and sqlite from extensions.duckdb.org. Set this to your own copy,
# or run enterprise/vendor-duckdb.sh and leave it empty: the build then takes them from the files.
# DUCKDB_EXTENSION_REPOSITORY=https://nexus.example.com/repository/duckdb

# --- Outgoing proxy during the build ----------------------------------------------------------------------
# Only if the repositories above are reached through a proxy
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1,.example.com

# --- Account running the backend --------------------------------------------------------------------------
# Owner of ./data and ./import on the host: id -u / id -g
# REFEX_UID=10001
# REFEX_GID=10001
