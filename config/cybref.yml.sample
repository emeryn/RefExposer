# Referentials of github.com/emeryn/cybref (output/ folder), generated from a RefExposer test campaign.
# Rename this file to cybref.yml (or copy the entries you need) and reload the configuration (System page).
#
# Every file of the repository is read; two files are left out because they currently contain an HTTP error page
# (protonvpn_all.json, standards_oui_ieee_opid.csv): RefExposer refuses them as corrupted sources.
referentials:
- id: iana-service-names-port-numbers
  name: Iana service names port numbers
  description: From github.com/emeryn/cybref (output/IANA_service_names_port_numbers.csv).
  category: Network
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/IANA_service_names_port_numbers.csv
  format: csv
  schedule: 0 5 * * *
- id: aws-ip-ranges
  name: Aws ip ranges
  description: From github.com/emeryn/cybref (output/aws_ip_ranges.json).
  category: Network
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/aws_ip_ranges.json
  format: json
  options:
    records_path: prefixes
  key: ip_prefix
  schedule: 0 5 * * *
- id: azure-ip-ranges
  name: Azure ip ranges
  description: From github.com/emeryn/cybref (output/azure_ip_ranges.json).
  category: Network
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/azure_ip_ranges.json
  format: json
  options:
    records_path: values
  schedule: 0 5 * * *
- id: bootloaders-io
  name: Bootloaders io
  description: From github.com/emeryn/cybref (output/bootloaders_io.json).
  category: Living off the land
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/bootloaders_io.json
  format: json
  schedule: 0 5 * * *
- id: cisa-kev
  name: Cisa kev
  description: From github.com/emeryn/cybref (output/cisa_kev.json).
  category: Vulnerabilities
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/cisa_kev.json
  format: json
  options:
    records_path: vulnerabilities
  key: cveID
  schedule: 0 5 * * *
- id: cwec-latest
  name: Cwec latest
  description: From github.com/emeryn/cybref (output/cwec_latest.xml).
  category: Vulnerabilities
  tags:
  - cybref
  source:
    urls:
    - https://raw.githubusercontent.com/emeryn/cybref/main/output/cwec_latest.xml
  format: xml
  options:
    records_path: Weakness
  transform: SELECT 'CWE-' || ID AS cwe_id, * FROM {source}
  key: ID
  schedule: 0 5 * * *
- id: disposable-email-blocklist
  name: Disposable email blocklist
  description: From github.com/emeryn/cybref (output/disposable_email_blocklist.list).
