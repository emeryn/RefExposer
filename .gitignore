# --- Runtime data (created by the application) ---------------------------------------------------------
data/*
!data/.gitkeep
import/*
!import/.gitkeep
sync/*
!sync/.gitkeep

# Referential definitions: only the samples are versioned (your own definitions may hold internal URLs).
# Remove these two lines to version your config/*.yml files.
config/*
!config/*.sample

# --- Secrets ------------------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.netrc
.npmrc
.pypirc
kubeconfig
.secret_key
secrets/
certs/

# --- Applications for other tools -------------------------------------------------------------------
# Not published yet: written and built, documentation and release to come. Removing this line brings them
# back, and these rules go with them (a negation cannot re-include a file whose folder is excluded):
#   integrations/**/refexposer_client.py     copies written into each package by integrations/package.sh
#   !integrations/shared/refexposer_client.py
#   integrations/opencti/config.yml          filled-in connector configuration (holds tokens)
#   !integrations/dist/.gitkeep              kept so the build container can write into dist/
integrations/

# Local Docker overrides (ports, volumes, SELinux labels…)
docker-compose.override.yml
compose.override.yml

# Backups and dumps
*.sql
*.sql.gz
*.dump
refexposer-config-*.json.gz*
refexposer-recovery-codes*.txt

# Brought in for a build with nothing to download (enterprise/vendor-python.sh, vendor-duckdb.sh):
# the folders are versioned, their content is not
backend/wheels/*
!backend/wheels/.gitkeep
backend/duckdb-extensions/*
!backend/duckdb-extensions/.gitkeep

# --- Python -------------------------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/
*.db
*.sqlite
*.sqlite3

# --- Node / frontend ----------------------------------------------------------------------------------
node_modules/
# dist/ and build/ hold generated artifacts
**/dist/*
**/build/
coverage/
*.tsbuildinfo
.vite/
npm-debug.log*

# --- Editors, OS, tools -------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
*.log

# Leftovers of an edit, a merge or a backup
*.bak
*.orig
*.rej
*_old.*
*.tmp

# --- Personal notes -----------------------------------------------------------------------------------
# Your own notes and cheat sheets: anything named *.local.md stays on your machine
*.local.md

# --- AI assistant context -----------------------------------------------------------------------------
# Instructions and transcripts of a coding assistant: never part of the project
.claude/
.clauderules
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.cursor/
.cursorrules
.clinerules
.roomodes
.aider*
.continue/
.github/copilot-instructions.md
